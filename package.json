{
  "name": "euclid-web",
  "version": "0.1.0",
  "description": "Angular web UI for the euclid server",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o --no-hmr",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.3.0",
